# Copy to `.env` and fill in. Never commit the real `.env`.
#
# Both values below are browser-safe. Supabase renamed its keys:
# `sb_publishable_...` is the modern replacement for the legacy `anon` JWT.
# Find them in: Dashboard → Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Legacy projects may still use the older name instead — the app accepts either:
# VITE_SUPABASE_ANON_KEY=eyJ...

# NEVER put the secret key (sb_secret_... / service_role) here or anywhere in
# frontend code. It bypasses Row Level Security and grants full database access.
